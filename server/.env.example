GEMINI_API_KEY=AIza...
PORT=3000

# Optional. Persistent directory for leaderboard.json AND content.json.
# Default: server/data (inside the repo — wiped on clean Hostinger redeploys).
# Hostinger Node (folder next to nodejs/): LEADERBOARD_DATA_DIR=../imajello-data
# Absolute path also works if it matches File Manager exactly (must start with /):
# LEADERBOARD_DATA_DIR=/home/u123/domains/yourdomain.com/imajello-data
# DATA_DIR is an alias for the same setting.

# Optional. Rift Pulls demo at /projects/rift-pulls: folder with its unzipped static build (see DEPLOY.md).
# Hostinger Node (folder next to nodejs/): RIFT_PULLS_DIR=../rift-pulls
# RIFT_PULLS_DIR=../rift-pulls
